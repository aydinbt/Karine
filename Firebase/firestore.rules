rules_version = '2';
// Karine: her oyuncu yalnız kendi kayıtlarını okur, yazar ve siler.
// Belge biçimi: users/{uid}/saves/{key} → { entry: string } (oyunun CloudEntry JSON'u).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/saves/{key} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && key.matches('bube-[A-Za-z0-9_-]+')
        && request.resource.data.keys().hasOnly(['entry'])
        && request.resource.data.entry is string
        && request.resource.data.entry.size() < 900000;
    }
    // Uzaktan ayar (en düşük sürüm, durdurulan vaka, duyuru): herkes okur, yalnız konsoldan yazılır.
    match /config/live {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
